# Copia este archivo a .env y ajusta los valores
PORT=3000

# Clave para firmar sesiones (mínimo 24 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# Primer usuario superadministrador (se crea solo la primera vez que arranca)
SUPERADMIN_NAME=Administrador general
SUPERADMIN_EMAIL=admin@tudominio.com
SUPERADMIN_PASSWORD=

# MySQL 8 / MariaDB 10.5+ (la base y las tablas se crean solas si el usuario tiene permiso)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mostrador
DB_PASSWORD=mostrador_pass
DB_NAME=mostrador

# Dirección(es) del frontend que pueden llamar a la API, separadas por comas, SIN "/" final ni ruta.
# GitHub Pages: https://TU_USUARIO.github.io  (aunque el sitio esté en /mostrador, aquí va solo el dominio)
CORS_ORIGIN=https://abpast.github.io

# Si lo pones detrás de Nginx/Caddy/Render/etc. usa 1
TRUST_PROXY=0
